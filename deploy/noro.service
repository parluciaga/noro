[Unit]
Description=Noro positional-snoring watchdog
After=multi-user.target

[Service]
Type=simple
# Adjust user and paths if the repo lives elsewhere on your Pi.
User=parluciaga
WorkingDirectory=/home/parluciaga/git/noro
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/parluciaga/git/noro/.venv/bin/python -m noro.main --source pi --detector tflite --actuator gpio --log-dir logs
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
